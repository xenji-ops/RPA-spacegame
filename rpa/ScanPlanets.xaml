<?xml version="1.0" encoding="utf-8"?>
<!--
  ScanPlanets.xaml  —  UiPath Workflow for Galaxy Rescue RPA Mission
  ==================================================================
  PURPOSE:
    Reads planet data from planet_data.xlsx, evaluates each planet against
    danger thresholds, then writes a JSON result file that the Python backend
    picks up and returns to the React frontend.

  HOW TO USE IN UIPATH STUDIO:
    1. Open UiPath Studio (Community Edition is free)
    2. Create a new "Blank Process" project
    3. Add this file as the Main.xaml (or import it)
    4. Required packages (install via Manage Packages):
       - UiPath.Excel.Activities
       - UiPath.System.Activities
       - Newtonsoft.Json (for JSON serialization)
    5. Set the ExcelPath and OutputPath arguments (or use defaults below)
    6. Publish to your UiPath Robot, or run directly from Studio

  ARGUMENTS:
    In_ExcelPath   (String, In)  — path to planet_data.xlsx
    In_OutputPath  (String, In)  — path where JSON result will be written
    Out_Result     (String, Out) — JSON string of scan results (same as file)

  NOTE: This workflow is designed for UiPath Studio 2022+ / 2023+
  The Python RPA runner (rpa_runner.py) produces identical results
  if UiPath is not installed.
-->
<Activity
  mc:Ignorable="sads sap sap2010 sads2010"
  x:Class="GalaxyRescue.ScanPlanets"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
  xmlns:sads2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger/2010"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Arguments ─────────────────────────────────────────────────────── -->
  <x:Members>
    <x:Property Name="In_ExcelPath"  Type="InArgument(x:String)" />
    <x:Property Name="In_OutputPath" Type="InArgument(x:String)" />
    <x:Property Name="Out_Result"    Type="OutArgument(x:String)" />
  </x:Members>

  <mva:VisualBasic.Settings>
    <mva:VisualBasicSettings>
      <mva:VisualBasicSettings.ImportedNamespaces>
        <mva:VisualBasicImportReference Assembly="mscorlib"         Import="System" />
        <mva:VisualBasicImportReference Assembly="mscorlib"         Import="System.Collections.Generic" />
        <mva:VisualBasicImportReference Assembly="System.Core"      Import="System.Linq" />
        <mva:VisualBasicImportReference Assembly="Newtonsoft.Json"  Import="Newtonsoft.Json" />
        <mva:VisualBasicImportReference Assembly="Newtonsoft.Json"  Import="Newtonsoft.Json.Linq" />
      </mva:VisualBasicImportReference>
    </mva:VisualBasicSettings>
  </mva:VisualBasic.Settings>

  <!--
    WORKFLOW LOGIC (pseudo-code for Studio implementation):
    ========================================================
    1. Log "Initializing Galaxy Bot v3.1..."
    2. Use Excel Application Scope / Use Excel File to open In_ExcelPath
    3. Read Range "PlanetDatabase!A4:G6" into DataTable dt_Planets
    4. Read Range "Thresholds!A2:B4"    into DataTable dt_Thresholds
    5. Parse thresholds into variables:
         threshold_O2     = 35
         threshold_Energy = 25
         threshold_Shield = 30
    6. For Each row in dt_Planets:
         planet_id     = row("ID").ToString
         planet_name   = row("Planet Name").ToString
         oxygen_val    = CInt(row("Oxygen (%)"))
         energy_val    = CInt(row("Energy (%)"))
         shield_val    = CInt(row("Shield (%)"))
         danger_flags  = New List(Of String)
         If oxygen_val  < threshold_O2     Then danger_flags.Add("O2 critical")
         If energy_val  < threshold_Energy Then danger_flags.Add("Energy critical")
         If shield_val  < threshold_Shield Then danger_flags.Add("Shield critical")
         in_danger = danger_flags.Count > 0
         Add planet object to result list
    7. Serialize result list to JSON using Newtonsoft.Json
    8. Write JSON to In_OutputPath using Write Text File
    9. Set Out_Result = json_string
    10. Log "Scan complete."

    UIPATH ACTIVITIES USED:
    - Log Message
    - Excel Application Scope (or Use Excel File for modern)
    - Read Range -> DataTable
    - For Each Row In Data Table
    - Assign
    - If
    - Add To Collection
    - Serialize Object (Newtonsoft) or Invoke Code
    - Write Text File
  -->

  <Sequence DisplayName="ScanPlanets — Galaxy Rescue RPA" sap2010:WorkflowViewState.IdRef="ScanPlanets">
    <Sequence.Variables>
      <Variable Name="dt_Planets"    Type="DataTable" />
      <Variable Name="dt_Thresholds" Type="DataTable" />
      <Variable Name="planet_list"   Type="scg:List(Of Object)" Default="New List(Of Object)()" />
      <Variable Name="json_result"   Type="String" />
      <Variable Name="thr_oxygen"    Type="Int32"  Default="35" />
      <Variable Name="thr_energy"    Type="Int32"  Default="25" />
      <Variable Name="thr_shield"    Type="Int32"  Default="30" />
    </Sequence.Variables>

    <!-- Step 1: Log startup -->
    <WriteLine Text="[Galaxy Bot] Initializing planetary scan workflow..." />

    <!-- Step 2-3: Read Excel — implement using Excel Application Scope in Studio -->
    <!-- ExcelApplicationScope workbookPath="In_ExcelPath" -->
    <!--   ReadRange sheetName="PlanetDatabase" range="A4:G6" result="{dt_Planets}" -->
    <!--   ReadRange sheetName="Thresholds"     range="A2:B4" result="{dt_Thresholds}" -->

    <!-- Step 4: For each planet row — implement as ForEachRow in Studio -->
    <!-- The Invoke Code below shows the VB.Net equivalent logic -->
    <InvokeCode>
      <InvokeCode.Code>
        <![CDATA[
        ' This code block runs inside UiPath's Invoke Code activity.
        ' In Studio, implement each step as discrete activities instead.
        ' This is provided as a reference for the automation logic.

        ' Simulated planet data (replace with actual DataTable reads from Excel)
        Dim planets As New List(Of Dictionary(Of String, Object)) From {
          New Dictionary(Of String, Object) From {
            {"id","P01"}, {"name","Zephyra"},  {"oxygen",28}, {"energy",72}, {"shield",85}
          },
          New Dictionary(Of String, Object) From {
            {"id","P02"}, {"name","Volcanis"}, {"oxygen",61}, {"energy",18}, {"shield",22}
          },
          New Dictionary(Of String, Object) From {
            {"id","P03"}, {"name","Crystara"}, {"oxygen",78}, {"energy",64}, {"shield",71}
          }
        }

        ' Evaluate each planet
        Dim results As New List(Of Dictionary(Of String, Object))
        For Each p In planets
          Dim flags As New List(Of String)
          If CInt(p("oxygen")) < thr_oxygen  Then flags.Add($"O2={p("oxygen")}% critical")
          If CInt(p("energy")) < thr_energy  Then flags.Add($"Energy={p("energy")}% critical")
          If CInt(p("shield")) < thr_shield  Then flags.Add($"Shield={p("shield")}% critical")
          p("in_danger") = flags.Count > 0
          p("danger_reasons") = String.Join("|", flags)
          results.Add(p)
        Next

        ' Serialize to JSON
        json_result = Newtonsoft.Json.JsonConvert.SerializeObject(
          New Dictionary(Of String, Object) From {
            {"planets", results}, {"rpa_mode", "UiPath Robot"}
          }
        )
        ]]>
      </InvokeCode.Code>
    </InvokeCode>

    <!-- Step 5: Write JSON output file -->
    <!-- WriteTextFile filePath="In_OutputPath" text="{json_result}" -->
    <WriteLine Text="[Galaxy Bot] Scan complete. Writing results..." />

    <!-- Step 6: Set output argument -->
    <Assign>
      <Assign.To><OutArgument x:TypeArguments="x:String">[Out_Result]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[json_result]</InArgument></Assign.Value>
    </Assign>

    <WriteLine Text="[Galaxy Bot] Mission scan report generated successfully." />
  </Sequence>
</Activity>
